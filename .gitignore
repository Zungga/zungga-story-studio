# secrets — the ElevenLabs key must never be committed (see docs/requirements.md §5)
.env
.env.*
settings.local.json
*.key
# exported videos and local scratch (keep copies locally / in cloud storage, not in git)
exports/
*.webm
*.mp4
node_modules/
.DS_Store

# local listening samples / generated audio (not committed)
voice-samples/
*.wav
.venv/
selected-voices/*/out/

# baked weather sounds are real assets (tools/make_sfx.py can re-make them)
!studio/assets/sfx/*.wav
