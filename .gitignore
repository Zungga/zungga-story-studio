# secrets — the ElevenLabs key must never be committed (see docs/requirements.md §5)
.env
.env.*
settings.local.json
*.key
# exported videos and local scratch (keep copies locally / in cloud storage, not in git)
exports/
*.webm
*.mp4
node_modules/
.DS_Store

# local listening samples / generated audio (not committed)
voice-samples/
*.wav
.venv/
selected-voices/*/out/

# baked weather sounds are real assets (tools/make_sfx.py can re-make them)
!studio/assets/sfx/*.wav

# studio: your projects and local settings stay on this Mac
projects/
settings.local.json
*.tmp


# rig test of an adult model — not for kids content, stays local
studio/characters/glb/medic.glb

# our own generated voices are real assets: the chosen reference clips + the story's Rio clips are kept in git
# (the narrator stays local — it is cloned from someone else's recording, not ours to publish)
!selected-voices/girl/*.wav
!selected-voices/boy-calm/*.wav
!selected-voices/boy-deep/*.wav
!stories/pocket-money/voice/*.wav
